          <datasource-dependencies datasource='federated.00c9u9m0m9hmou16h7p7p02pubrw'>
            <column caption='Crime Category' datatype='string' name='[Calculation_1173199725563904]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Crm Cd Desc] = &quot;VEHICLE - STOLEN&quot;&#13;&#10;OR [Crm Cd Desc] = &quot;VEHICLE - ATTEMPT STOLEN&quot;&#13;&#10;THEN &quot;Vehicle Theft&quot;&#13;&#10;&#13;&#10;ELSEIF CONTAINS(UPPER([Crm Cd Desc]), &quot;WEAPON&quot;)&#13;&#10;OR CONTAINS(UPPER([Crm Cd Desc]), &quot;FIREARM&quot;)&#13;&#10;OR CONTAINS(UPPER([Crm Cd Desc]), &quot;SHOTS&quot;)&#13;&#10;OR CONTAINS(UPPER([Crm Cd Desc]), &quot;BRANDISH&quot;)&#13;&#10;THEN &quot;Weapon-Related Crimes&quot;&#13;&#10;&#13;&#10;ELSEIF&#13;&#10;    [Crm Cd Desc] = &quot;BURGLARY&quot;&#13;&#10;OR  [Crm Cd Desc] = &quot;BURGLARY FROM VEHICLE&quot;&#13;&#10;OR  [Crm Cd Desc] = &quot;BURGLARY, ATTEMPTED&quot;&#13;&#10;OR  [Crm Cd Desc] = &quot;BURGLARY FROM VEHICLE, ATTEMPTED&quot;&#13;&#10;THEN &quot;Burglary&quot;&#13;&#10;&#13;&#10;ELSEIF CONTAINS(UPPER([Crm Cd Desc]), &quot;BOAT&quot;)&#13;&#10;THEN &quot;Boat Theft&quot;&#13;&#10;&#13;&#10;ELSEIF CONTAINS(UPPER([Crm Cd Desc]), &quot;BOMB&quot;)&#13;&#10;OR CONTAINS(UPPER([Crm Cd Desc]), &quot;TERROR&quot;)&#13;&#10;THEN &quot;Bomb Scare &amp; Terrorism&quot;&#13;&#10;&#13;&#10;ELSEIF CONTAINS(UPPER([Crm Cd Desc]), &quot;BIKE&quot;)&#13;&#10;THEN &quot;Bike Theft&quot;&#13;&#10;&#13;&#10;ELSEIF CONTAINS(UPPER([Crm Cd Desc]), &quot;CONTRIBUTING&quot;)&#13;&#10;THEN &quot;Contributing&quot;&#13;&#10;&#13;&#10;ELSEIF CONTAINS(UPPER([Crm Cd Desc]), &quot;CONSPIRACY&quot;)&#13;&#10;THEN &quot;Conspiracy&quot;&#13;&#10;&#13;&#10;ELSEIF CONTAINS(UPPER([Crm Cd Desc]), &quot;CHILD&quot;)&#13;&#10;THEN &quot;Child Exploitation &amp; Abuse&quot;&#13;&#10;&#13;&#10;ELSEIF CONTAINS(UPPER([Crm Cd Desc]), &quot;COURT&quot;)&#13;&#10;OR CONTAINS(UPPER([Crm Cd Desc]), &quot;RESTRAINING&quot;)&#13;&#10;OR CONTAINS(UPPER([Crm Cd Desc]), &quot;PROTECTIVE ORDER&quot;)&#13;&#10;THEN &quot;Court &amp; Restraining Order Violations&quot;&#13;&#10;&#13;&#10;ELSEIF CONTAINS(UPPER([Crm Cd Desc]), &quot;DISTURB&quot;)&#13;&#10;OR CONTAINS(UPPER([Crm Cd Desc]), &quot;DISRUPT&quot;)&#13;&#10;OR CONTAINS(UPPER([Crm Cd Desc]), &quot;INCITING&quot;)&#13;&#10;THEN &quot;Disturbances&quot;&#13;&#10;&#13;&#10;ELSEIF CONTAINS(UPPER([Crm Cd Desc]), &quot;FORGERY&quot;)&#13;&#10;OR CONTAINS(UPPER([Crm Cd Desc]), &quot;FRAUD&quot;)&#13;&#10;OR CONTAINS(UPPER([Crm Cd Desc]), &quot;BUNCO&quot;)&#13;&#10;OR CONTAINS(UPPER([Crm Cd Desc]), &quot;COUNTERFEIT&quot;)&#13;&#10;OR CONTAINS(UPPER([Crm Cd Desc]), &quot;CREDIT CARD&quot;)&#13;&#10;OR CONTAINS(UPPER([Crm Cd Desc]), &quot;EMBEZZLEMENT&quot;)&#13;&#10;THEN &quot;Forgery &amp; Fraud&quot;&#13;&#10;&#13;&#10;ELSEIF CONTAINS(UPPER([Crm Cd Desc]), &quot;FALSE POLICE REPORT&quot;)&#13;&#10;THEN &quot;False Police Report&quot;&#13;&#10;&#13;&#10;ELSEIF CONTAINS(UPPER([Crm Cd Desc]), &quot;FALSE IMPRISONMENT&quot;)&#13;&#10;THEN &quot;False Imprisonment&quot;&#13;&#10;&#13;&#10;ELSEIF CONTAINS(UPPER([Crm Cd Desc]), &quot;DRUGS TO A MINOR&quot;)&#13;&#10;THEN &quot;Drugs to a Minor&quot;&#13;&#10;&#13;&#10;ELSEIF CONTAINS(UPPER([Crm Cd Desc]), &quot;ANIMAL&quot;)&#13;&#10;OR CONTAINS(UPPER([Crm Cd Desc]), &quot;BEASTIALITY&quot;)&#13;&#10;THEN &quot;Animal Cruelty&quot;&#13;&#10;&#13;&#10;ELSEIF CONTAINS(UPPER([Crm Cd Desc]), &quot;TRESPASS&quot;)&#13;&#10;THEN &quot;Trespassing&quot;&#13;&#10;&#13;&#10;ELSEIF CONTAINS(UPPER([Crm Cd Desc]), &quot;BATTERY&quot;)&#13;&#10;OR CONTAINS(UPPER([Crm Cd Desc]), &quot;ASSAULT&quot;)&#13;&#10;OR CONTAINS(UPPER([Crm Cd Desc]), &quot;INTIMATE PARTNER&quot;)&#13;&#10;THEN &quot;Assault &amp; Battery&quot;&#13;&#10;&#13;&#10;ELSEIF CONTAINS(UPPER([Crm Cd Desc]), &quot;ARSON&quot;)&#13;&#10;OR CONTAINS(UPPER([Crm Cd Desc]), &quot;VANDALISM&quot;)&#13;&#10;THEN &quot;Arson &amp; Vandalism&quot;&#13;&#10;&#13;&#10;ELSEIF CONTAINS(UPPER([Crm Cd Desc]), &quot;GRAND THEFT&quot;)&#13;&#10;THEN &quot;Grand Theft ($950.01 &amp; Over)&quot;&#13;&#10;&#13;&#10;ELSEIF CONTAINS(UPPER([Crm Cd Desc]), &quot;THREAT&quot;)&#13;&#10;OR CONTAINS(UPPER([Crm Cd Desc]), &quot;HARASS&quot;)&#13;&#10;OR CONTAINS(UPPER([Crm Cd Desc]), &quot;THREATENING&quot;)&#13;&#10;OR CONTAINS(UPPER([Crm Cd Desc]), &quot;LETTERS&quot;)&#13;&#10;THEN &quot;Threats &amp; Harassment&quot;&#13;&#10;&#13;&#10;ELSEIF CONTAINS(UPPER([Crm Cd Desc]), &quot;ATTEMPT&quot;)&#13;&#10;THEN &quot;Theft Attempt&quot;&#13;&#10;&#13;&#10;ELSEIF CONTAINS(UPPER([Crm Cd Desc]), &quot;RAPE&quot;)&#13;&#10;OR CONTAINS(UPPER([Crm Cd Desc]), &quot;SEXUAL&quot;)&#13;&#10;OR CONTAINS(UPPER([Crm Cd Desc]), &quot;ORAL COPULATION&quot;)&#13;&#10;OR CONTAINS(UPPER([Crm Cd Desc]), &quot;LEWD&quot;)&#13;&#10;OR CONTAINS(UPPER([Crm Cd Desc]), &quot;SODOMY&quot;)&#13;&#10;THEN &quot;Sexual Assault &amp; Rape&quot;&#13;&#10;&#13;&#10;ELSEIF CONTAINS(UPPER([Crm Cd Desc]), &quot;SEX OFFENDER&quot;)&#13;&#10;THEN &quot;Sex Offender Registrant Out of Compliance&quot;&#13;&#10;&#13;&#10;ELSEIF CONTAINS(UPPER([Crm Cd Desc]), &quot;ROBBERY&quot;)&#13;&#10;THEN &quot;Robbery&quot;&#13;&#10;&#13;&#10;ELSEIF CONTAINS(UPPER([Crm Cd Desc]), &quot;PETTY THEFT&quot;)&#13;&#10;OR CONTAINS(UPPER([Crm Cd Desc]), &quot;$950 &amp; UNDER&quot;)&#13;&#10;THEN &quot;Petty Theft ($950 &amp; Under)&quot;&#13;&#10;&#13;&#10;ELSEIF CONTAINS(UPPER([Crm Cd Desc]), &quot;RESISTING ARREST&quot;)&#13;&#10;THEN &quot;Resisting Arrest&quot;&#13;&#10;&#13;&#10;ELSEIF CONTAINS(UPPER([Crm Cd Desc]), &quot;PICKPOCKET&quot;)&#13;&#10;THEN &quot;Pickpocket&quot;&#13;&#10;&#13;&#10;ELSEIF CONTAINS(UPPER([Crm Cd Desc]), &quot;PURSE SNATCH&quot;)&#13;&#10;THEN &quot;Purse Snatching&quot;&#13;&#10;&#13;&#10;ELSEIF CONTAINS(UPPER([Crm Cd Desc]), &quot;KIDNAPPING&quot;)&#13;&#10;THEN &quot;Kidnapping&quot;&#13;&#10;&#13;&#10;ELSEIF CONTAINS(UPPER([Crm Cd Desc]), &quot;INDECENT&quot;)&#13;&#10;OR CONTAINS(UPPER([Crm Cd Desc]), &quot;PANDERING&quot;)&#13;&#10;OR CONTAINS(UPPER([Crm Cd Desc]), &quot;PIMPING&quot;)&#13;&#10;OR CONTAINS(UPPER([Crm Cd Desc]), &quot;PROWLER&quot;)&#13;&#10;OR CONTAINS(UPPER([Crm Cd Desc]), &quot;PEEPING&quot;)&#13;&#10;THEN &quot;Indecent &amp; Public Sexual Crimes&quot;&#13;&#10;&#13;&#10;ELSEIF CONTAINS(UPPER([Crm Cd Desc]), &quot;DUMPING&quot;)&#13;&#10;THEN &quot;Illegal Dumping&quot;&#13;&#10;&#13;&#10;ELSEIF CONTAINS(UPPER([Crm Cd Desc]), &quot;HUMAN TRAFFICKING&quot;)&#13;&#10;THEN &quot;Human Trafficking &amp; Exploitation&quot;&#13;&#10;&#13;&#10;ELSEIF CONTAINS(UPPER([Crm Cd Desc]), &quot;HOMICIDE&quot;)&#13;&#10;OR CONTAINS(UPPER([Crm Cd Desc]), &quot;MANSLAUGHTER&quot;)&#13;&#10;THEN &quot;Homicide &amp; Manslaughter&quot;&#13;&#10;&#13;&#10;ELSE&#13;&#10;&quot;Other Miscellaneous Crime&quot;&#13;&#10;END' />
            </column>
